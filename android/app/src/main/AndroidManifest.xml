<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: open GGMP URLs in the app. autoVerify checks
                 /.well-known/assetlinks.json on each domain, which is what
                 suppresses the "open with" chooser dialog. Both hosts are listed
                 so existing gemmarket.vercel.app links keep working alongside ggmp.app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ggmp.app" />
                <data android:scheme="https" android:host="gemmarket.vercel.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: photographing gems directly from the Post a Listing screen -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Required on Android 13+ (API 33) to display push notifications.
         Without it the runtime permission request is auto-denied and no
         notification is ever shown, even though FCM registration succeeds. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera hardware is optional, so the app still installs on devices without one -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
